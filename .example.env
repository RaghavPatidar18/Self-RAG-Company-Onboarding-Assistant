GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Document indexing and retrieval
DOCS_FOLDER=documents
EMBEDDING_MODEL=all-MiniLM-L6-v2
DOCUMENT_CHUNK_SIZE=512
DOCUMENT_CHUNK_OVERLAP=200
RETRIEVER_TOP_K=5
QDRANT_COLLECTION_NAME=ocr_chunks
QDRANT_URL=http://localhost:6333
QDRANT_VECTOR_DIMENSION=384
QDRANT_UPSERT_BATCH_SIZE=64

# Application memory, retries, and database connection pool
SHORT_TERM_MAX_TURNS=10
SHORT_TERM_RETAIN_TURNS=4
MAX_ANSWER_RETRIES=3
MAX_RETRIEVAL_REWRITES=3
POSTGRES_POOL_MAX_SIZE=20

# Evaluation judge settings
EVAL_GROQ_MODEL=openai/gpt-oss-120b
EVAL_GROQ_TEMPERATURE=0
EVAL_GROQ_MAX_RETRIES=2

# Application logs: console plus rotating logs/app.log
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db
DB_PORT=5432

# Optional LangSmith tracing 
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Agri-RAG

# Optional semantic cache configuration
SEMANTIC_CACHE_THRESHOLD=0.88
SEMANTIC_CACHE_PATH=:memory:
SEMANTIC_CACHE_COLLECTION=semantic_cache
